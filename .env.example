# Copy this file to .env and fill in real values. Never commit .env.

# --- Stage 2: SerpApi (reverse image search) ---
SERPAPI_KEY=

# Optional. Yandex and Bing's reverse-image engines both need a real public
# image URL (SerpApi's own upload endpoint doesn't provide one) -- a free
# key from https://api.imgbb.com/ unlocks them by temporarily hosting the
# uploaded photo there (auto-deleted within 60 seconds). Without this,
# search silently falls back to Google Lens only.
IMGBB_API_KEY=

# --- Stage 5/6: Blockchain ---
# Two ways to run this: a local Hardhat chain (default, for development) or
# the public Sepolia testnet (for a demo/submission with a real block
# explorer link). Only one RPC/key pair needs to be set at a time.

# Option A -- local Hardhat chain (started via `npx hardhat node`).
# HARDHAT_RPC_URL/HARDHAT_PRIVATE_KEY are the legacy names and still work as
# fallbacks if CHAIN_RPC_URL/CHAIN_PRIVATE_KEY are left unset.
HARDHAT_RPC_URL=http://127.0.0.1:8545
# Private key of one of Hardhat's pre-funded local dev accounts (printed to the
# console when `npx hardhat node` starts). These are well-known, public,
# local-only test keys with no real funds behind them -- never reuse a real key.
HARDHAT_PRIVATE_KEY=

# Option B -- Sepolia public testnet. Set these instead (they take priority
# over the HARDHAT_* vars above) and set BLOCK_EXPLORER_URL too:
# CHAIN_RPC_URL=https://sepolia.infura.io/v3/<your-project-id>
# CHAIN_PRIVATE_KEY=<a funded Sepolia test account's private key -- never a real one>
# BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
CHAIN_RPC_URL=
CHAIN_PRIVATE_KEY=
BLOCK_EXPLORER_URL=

# Filled in after deploying the contract (either
# `npx hardhat run scripts/deploy.js --network localhost` or `--network sepolia`)
CONTRACT_ADDRESS=

# --- contracts/hardhat.config.js: Sepolia deployment (used only by `npx hardhat
# run scripts/deploy.js --network sepolia`, read directly by Hardhat, not the
# Python backend) ---
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
